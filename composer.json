{
    "name": "gate/gateapi-php",
    "version": "8.2.172",
    "description": "Welcome to Gate API APIv4 provides operations related to spot, margin, and contract trading, including public interfaces for querying market data and authenticated private interfaces for implementing API-based automated trading.",
    "keywords": [
        "gate",
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://www.gate.com",
    "license": "unlicense",
    "authors": [
        {
            "name": "Gate",
            "homepage": "https://www.gate.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.16",
        "guzzlehttp/psr7": "^2.13.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33",
        "squizlabs/php_codesniffer": "^3.13.6",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": { "GateApi\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": { "GateApi\\" : "test/" }
    }
}
